<Window
    x:Class="SpartanX.App.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SpartanX.App.Settings"
    xmlns:l="using:SpartanX.App.Localization"
    Title="SpartanX Settings">

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Background="{ThemeResource SidebarBrush}" Padding="10,0,10,12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <AutoSuggestBox x:Name="Search" Grid.Row="1" PlaceholderText="{l:Tr Key=Settings.Search}" QueryIcon="Find"
                            TextChanged="Search_TextChanged" />
            <ListView x:Name="Nav" Grid.Row="2" SelectionMode="Single" SelectionChanged="Nav_SelectionChanged" Margin="-6,4,-6,0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:NavEntry">
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                            <Border Width="26" Height="26" CornerRadius="7" Background="{x:Bind Brush}">
                                <FontIcon FontFamily="{StaticResource SymbolFont}" Glyph="{x:Bind Glyph}" FontSize="14" Foreground="White" />
                            </Border>
                            <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="Scroller" Grid.Row="1" Padding="36,0,36,36">
                <StackPanel MaxWidth="780" Spacing="18">
                    <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
                    <ContentPresenter x:Name="PageHost" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Drag region across the whole top edge (caption buttons sit on top of it). -->
        <Grid x:Name="TitleBarArea" Grid.ColumnSpan="2" Height="44" VerticalAlignment="Top" Background="Transparent" />
    </Grid>
</Window>
