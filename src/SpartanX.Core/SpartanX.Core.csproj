<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Platform-independent heart of SpartanX: settings, view-models, animation math,
    localisation and update logic. It has no Windows dependency so it builds and is
    unit-tested on any OS.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SpartanX.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Strings\*.json" LogicalName="SpartanX.Strings.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpartanX.Core.Tests" />
  </ItemGroup>
</Project>
