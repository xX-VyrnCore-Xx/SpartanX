<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <Product>SpartanX</Product>
    <Company>SpartanX contributors</Company>
    <Authors>SpartanX contributors</Authors>
    <Copyright>Copyright © SpartanX contributors</Copyright>
    <RepositoryUrl>https://github.com/xX-VyrnCore-Xx/SpartanX</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Single source of truth for the version. CI overrides it from the git tag (vX.Y.Z). -->
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>
</Project>
