<UserControl
    x:Class="SpartanX.App.Settings.Pages.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:l="using:SpartanX.App.Localization">

    <StackPanel Spacing="4">
        <tk:SettingsCard Header="{l:Tr Key=Settings.Appearance.Theme}">
            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE793;" /></tk:SettingsCard.HeaderIcon>
            <ComboBox x:Name="ThemeBox" MinWidth="180" />
        </tk:SettingsCard>

        <tk:SettingsExpander Header="{l:Tr Key=Settings.Appearance.Accent}" Description="{l:Tr Key=Settings.Appearance.AccentDescription}" IsExpanded="True">
            <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE790;" /></tk:SettingsExpander.HeaderIcon>
            <StackPanel x:Name="Swatches" Orientation="Horizontal" Spacing="10" />
            <tk:SettingsExpander.Items>
                <tk:SettingsCard Header="{l:Tr Key=Settings.Appearance.CustomAccent}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="CustomPreview" Width="28" Height="28" CornerRadius="14" />
                        <TextBox x:Name="HexBox" Width="110" MaxLength="7" TextChanged="Hex_TextChanged" />
                    </StackPanel>
                </tk:SettingsCard>
            </tk:SettingsExpander.Items>
        </tk:SettingsExpander>

        <tk:SettingsCard Header="{l:Tr Key=Settings.Appearance.Material}" Description="{l:Tr Key=Settings.Appearance.MaterialDescription}">
            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE81E;" /></tk:SettingsCard.HeaderIcon>
            <ComboBox x:Name="MaterialBox" MinWidth="180" />
        </tk:SettingsCard>
    </StackPanel>
</UserControl>
