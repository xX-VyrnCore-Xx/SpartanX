<UserControl
    x:Class="SpartanX.App.Settings.Pages.MenuBarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:l="using:SpartanX.App.Localization">

    <StackPanel Spacing="4">
        <tk:SettingsCard Header="{l:Tr Key=Settings.MenuBar.Enabled}" Description="{l:Tr Key=Settings.MenuBar.EnabledDescription}">
            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE700;" /></tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind M.Enabled, Mode=TwoWay}" />
        </tk:SettingsCard>
        <tk:SettingsCard Header="{l:Tr Key=Settings.MenuBar.ClockFormat}">
            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE823;" /></tk:SettingsCard.HeaderIcon>
            <ComboBox x:Name="ClockBox" MinWidth="180" />
        </tk:SettingsCard>
        <tk:SettingsCard Header="{l:Tr Key=Settings.MenuBar.ShowSeconds}">
            <ToggleSwitch IsOn="{x:Bind M.ShowSeconds, Mode=TwoWay}" />
        </tk:SettingsCard>
        <tk:SettingsCard Header="{l:Tr Key=Settings.MenuBar.ShowDate}">
            <ToggleSwitch IsOn="{x:Bind M.ShowDate, Mode=TwoWay}" />
        </tk:SettingsCard>
        <tk:SettingsCard Header="{l:Tr Key=Settings.MenuBar.ShowBattery}">
            <ToggleSwitch IsOn="{x:Bind M.ShowBatteryPercentage, Mode=TwoWay}" />
        </tk:SettingsCard>
        <tk:SettingsCard Header="{l:Tr Key=Settings.MenuBar.ShowActiveApp}">
            <ToggleSwitch IsOn="{x:Bind M.ShowActiveAppName, Mode=TwoWay}" />
        </tk:SettingsCard>
    </StackPanel>
</UserControl>
