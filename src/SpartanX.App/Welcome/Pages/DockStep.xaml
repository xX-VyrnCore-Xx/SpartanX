<UserControl
    x:Class="SpartanX.App.Welcome.Pages.DockStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:SpartanX.App.Helpers"
    xmlns:l="using:SpartanX.App.Localization">

    <Grid MaxWidth="720" VerticalAlignment="Center" ColumnSpacing="36">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Live preview -->
        <Border CornerRadius="16" Height="300" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF2B1A3D" Offset="0" />
                    <GradientStop Color="#FF7A1E24" Offset="0.6" />
                    <GradientStop Color="#FFE0A34E" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Border Height="12" VerticalAlignment="Top" Background="#55FFFFFF" CornerRadius="16,16,0,0" />
                <Border x:Name="PreviewBar" CornerRadius="10" Padding="6" Background="#A6282828" BorderBrush="#33FFFFFF" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8">
                    <StackPanel x:Name="PreviewIcons" Orientation="Horizontal" Spacing="4" />
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" Spacing="18" VerticalAlignment="Center">
            <StackPanel Spacing="6">
                <TextBlock Text="{l:Tr Key=Welcome.Dock.Title}" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{l:Tr Key=Welcome.Dock.Subtitle}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="{l:Tr Key=Settings.Dock.Position}" />
                <ComboBox x:Name="PositionBox" HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="{l:Tr Key=Settings.Dock.Size}" />
                <Slider Minimum="32" Maximum="96" StepFrequency="2" Value="{x:Bind Dock.IconSize, Mode=TwoWay}" />
            </StackPanel>

            <ToggleSwitch Header="{l:Tr Key=Settings.Dock.Magnification}" IsOn="{x:Bind Dock.Magnification, Mode=TwoWay}" />
            <ToggleSwitch Header="{l:Tr Key=Settings.Dock.AutoHide}" IsOn="{x:Bind Dock.AutoHide, Mode=TwoWay}" />
            <ToggleSwitch Header="{l:Tr Key=Settings.General.HideTaskbar}" IsOn="{x:Bind General.HideWindowsTaskbar, Mode=TwoWay}" />
        </StackPanel>
    </Grid>
</UserControl>
