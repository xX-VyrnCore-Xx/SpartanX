<UserControl
    x:Class="SpartanX.App.Welcome.Pages.LanguageStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:SpartanX.Core.Localization"
    xmlns:l="using:SpartanX.App.Localization">

    <StackPanel MaxWidth="520" VerticalAlignment="Center" Spacing="22">
        <FontIcon FontFamily="{StaticResource SymbolFont}" Glyph="&#xE774;" FontSize="48" Foreground="{StaticResource SpartanAccentBrush}" />
        <StackPanel Spacing="6">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleLargeTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock x:Name="SubtitleText" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <ListView x:Name="Languages" SelectionMode="Single" ItemsSource="{x:Bind ViewModel.Languages}"
                  SelectionChanged="Languages_SelectionChanged"
                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:LanguageOption">
                    <Grid Padding="4,12">
                        <TextBlock Text="{x:Bind NativeName}" FontSize="15" />
                        <TextBlock Text="{x:Bind Tag}" HorizontalAlignment="Right" Opacity="0.5" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</UserControl>
