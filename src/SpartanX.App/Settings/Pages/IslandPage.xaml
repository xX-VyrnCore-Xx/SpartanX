<UserControl
    x:Class="SpartanX.App.Settings.Pages.IslandPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:h="using:SpartanX.App.Helpers"
    xmlns:l="using:SpartanX.App.Localization">

    <StackPanel Spacing="4">
        <tk:SettingsCard Header="{l:Tr Key=Settings.Island.Enabled}" Description="{l:Tr Key=Settings.Island.EnabledDescription}">
            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE91C;" /></tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind I.Enabled, Mode=TwoWay}" />
        </tk:SettingsCard>
        <tk:SettingsCard Header="{l:Tr Key=Settings.Island.Interaction}">
            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B0;" /></tk:SettingsCard.HeaderIcon>
            <ComboBox x:Name="InteractionBox" MinWidth="240" />
        </tk:SettingsCard>
        <tk:SettingsExpander Header="{l:Tr Key=Settings.Island.AutoExpand}" Description="{l:Tr Key=Settings.Island.AutoExpandDescription}" IsExpanded="True">
            <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE740;" /></tk:SettingsExpander.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind I.AutoExpandOnEvents, Mode=TwoWay}" />
            <tk:SettingsExpander.Items>
                <tk:SettingsCard Header="{l:Tr Key=Settings.Island.AutoCollapse}" Description="{x:Bind h:Bind.Seconds(I.AutoCollapseSeconds), Mode=OneWay}">
                    <Slider Width="220" Minimum="1" Maximum="12" StepFrequency="0.5" Value="{x:Bind I.AutoCollapseSeconds, Mode=TwoWay}" />
                </tk:SettingsCard>
            </tk:SettingsExpander.Items>
        </tk:SettingsExpander>

        <TextBlock Text="{l:Tr Key=Settings.Island.Modules}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,20,0,4" />
        <tk:SettingsCard Header="{l:Tr Key=Settings.Island.Media}" Description="{l:Tr Key=Settings.Island.MediaDescription}">
            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8D6;" /></tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind I.MediaModule, Mode=TwoWay}" />
        </tk:SettingsCard>
        <tk:SettingsCard x:Name="NotificationsCard" Header="{l:Tr Key=Settings.Island.Notifications}" Description="{l:Tr Key=Settings.Island.NotificationsDescription}">
            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEA8F;" /></tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind I.NotificationsModule, Mode=TwoWay}" />
        </tk:SettingsCard>
        <tk:SettingsCard Header="{l:Tr Key=Settings.Island.SystemStatus}" Description="{l:Tr Key=Settings.Island.SystemStatusDescription}">
            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE767;" /></tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind I.SystemStatusModule, Mode=TwoWay}" />
        </tk:SettingsCard>
        <tk:SettingsCard Header="{l:Tr Key=Settings.Island.Timer}" Description="{l:Tr Key=Settings.Island.TimerDescription}">
            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE916;" /></tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind I.TimerModule, Mode=TwoWay}" />
        </tk:SettingsCard>
        <tk:SettingsExpander Header="{l:Tr Key=Settings.Island.Weather}" Description="{l:Tr Key=Settings.Island.WeatherDescription}" IsExpanded="True">
            <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE753;" /></tk:SettingsExpander.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind I.WeatherModule, Mode=TwoWay}" />
            <tk:SettingsExpander.Items>
                <tk:SettingsCard Header="{l:Tr Key=Settings.Island.WeatherCity}" IsEnabled="{x:Bind I.WeatherModule, Mode=OneWay}">
                    <TextBox Width="220" PlaceholderText="{l:Tr Key=Settings.Island.WeatherCityPlaceholder}" Text="{x:Bind I.WeatherCity, Mode=TwoWay}" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="{l:Tr Key=Settings.Island.Fahrenheit}" IsEnabled="{x:Bind I.WeatherModule, Mode=OneWay}">
                    <ToggleSwitch IsOn="{x:Bind I.UseFahrenheit, Mode=TwoWay}" />
                </tk:SettingsCard>
            </tk:SettingsExpander.Items>
        </tk:SettingsExpander>
    </StackPanel>
</UserControl>
