<UserControl
    x:Class="SpartanX.App.Welcome.Pages.IslandStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:SpartanX.App.Helpers"
    xmlns:l="using:SpartanX.App.Localization">

    <Grid MaxWidth="720" VerticalAlignment="Center" ColumnSpacing="36">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Live, looping demo of the island morph. -->
        <Border CornerRadius="16" Height="300" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF102A43" Offset="0" />
                    <GradientStop Color="#FF5E5CE6" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Border Height="18" VerticalAlignment="Top" Background="#40FFFFFF" CornerRadius="16,16,0,0" />
                <Border x:Name="DemoPill" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" Width="90" Height="18" CornerRadius="9">
                    <Grid x:Name="DemoContent" Padding="10,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFF375F" Offset="0" />
                                        <GradientStop Color="#FFFF9F0A" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Spartan Anthem" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="SpartanX" Foreground="#99FFFFFF" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
            <StackPanel Spacing="6">
                <TextBlock Text="{l:Tr Key=Welcome.Island.Title}" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{l:Tr Key=Welcome.Island.Subtitle}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Content="{l:Tr Key=Settings.Island.Media}" IsChecked="{x:Bind Island.MediaModule, Mode=TwoWay}" />
            <CheckBox Content="{l:Tr Key=Settings.Island.Notifications}" IsChecked="{x:Bind Island.NotificationsModule, Mode=TwoWay}" />
            <CheckBox Content="{l:Tr Key=Settings.Island.SystemStatus}" IsChecked="{x:Bind Island.SystemStatusModule, Mode=TwoWay}" />
            <CheckBox Content="{l:Tr Key=Settings.Island.Timer}" IsChecked="{x:Bind Island.TimerModule, Mode=TwoWay}" />
            <CheckBox Content="{l:Tr Key=Settings.Island.Weather}" IsChecked="{x:Bind Island.WeatherModule, Mode=TwoWay}" />
            <TextBox PlaceholderText="{l:Tr Key=Settings.Island.WeatherCityPlaceholder}" Text="{x:Bind Island.WeatherCity, Mode=TwoWay}"
                     Visibility="{x:Bind h:Bind.Visible(Island.WeatherModule), Mode=OneWay}" />
            <StackPanel Spacing="6">
                <TextBlock Text="{l:Tr Key=Settings.Island.Interaction}" />
                <ComboBox x:Name="InteractionBox" HorizontalAlignment="Stretch" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
