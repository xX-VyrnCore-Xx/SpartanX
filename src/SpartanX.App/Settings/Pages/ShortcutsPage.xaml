<UserControl
    x:Class="SpartanX.App.Settings.Pages.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:l="using:SpartanX.App.Localization">

    <StackPanel Spacing="4">
        <InfoBar x:Name="ConflictBar" Severity="Warning" IsOpen="False" Title="{l:Tr Key=Settings.Shortcuts.Conflict}" />
        <TextBlock Text="{l:Tr Key=Settings.Shortcuts.Hint}" Opacity="0.7" TextWrapping="Wrap" Margin="2,0,0,8" />
        <StackPanel x:Name="Rows" Spacing="4" />
    </StackPanel>
</UserControl>
